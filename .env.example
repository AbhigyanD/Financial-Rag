# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real API keys.

# --- Required (default setup: Groq for answers, local embeddings) ---
GROQ_API_KEY=

# --- Only if you switch providers ---
# LLM_PROVIDER=anthropic        -> needs ANTHROPIC_API_KEY
# EMBEDDING_PROVIDER=openai     -> needs OPENAI_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional (defaults shown) ---
# Generation
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile
# CLAUDE_MODEL=claude-opus-5
# LLM_MAX_TOKENS=4096
# CONTEXT_TOKEN_BUDGET=4000

# Embeddings ("local" = fastembed on CPU, free; model downloads once, ~90 MB)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   (openai default: text-embedding-3-small)
# MODEL_CACHE_DIR=./model_cache
# EMBEDDING_CACHE_DIR=./embedding_cache

# Chunking (characters, not tokens)
# CHUNK_MAX_SIZE=1000
# CHUNK_OVERLAP=100

# Vector store (collection name gets the embedding model appended)
# PERSIST_DIRECTORY=./chroma_data
# COLLECTION_NAME=financial_documents

# Retrieval
# HYBRID_RETRIEVAL=false
# RERANK=false
# SIMILARITY_THRESHOLD=0.62   (measured for local MiniLM; re-measure for other models)

# Observability (cost is an ESTIMATE from pricing.toml)
# LOG_LEVEL=INFO
# PRICING_FILE=pricing.toml

# API
# REQUEST_TIMEOUT_SECONDS=60
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501
